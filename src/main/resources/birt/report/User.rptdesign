            <property name="dataSource">User</property>
            <method name="open"><![CDATA[importPackage(Packages.java.lang);

// 從 Java 的 AppContext 拿出 dataList
var dataList = reportContext.getAppContext().get("dataList");

if (dataList != null) {
    System.out.println("資料筆數：" + dataList.size());
} else {
    System.out.println("dataList 為 null");
}

// 儲存在 Scripted DataSet 的區域變數中（屬於當前執行個體）
this.dataList = dataList;
this.index = 0;]]></method>
            <method name="fetch"><![CDATA[// 若資料已取完，則返回 false 結束
if (this.dataList == null || this.index >= this.dataList.size()) {
    return false;
}

// 取得當前資料列
var rowMap = this.dataList.get(this.index);

// 設定對應的欄位（欄位名稱需與 DataSet 的 Output Columns 對應）
row["number"] = rowMap.get("number");
row["name"] = rowMap.get("name");
row["chineseScore"] = rowMap.get("chineseScore");
row["mathScore"] = rowMap.get("mathScore");
row["englishScore"] = rowMap.get("englishScore");
row["testTime"] = rowMap.get("testTime");

// 移動索引到下一筆
this.index++;

return true;
]]></method>
        </script-data-set>
